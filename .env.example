# Yolo media node (service/node). The root .env is loaded automatically;
# exported variables take precedence. DRIVEIN_ENV_FILE points at another file
# (an empty value loads none).

# Shared with the control plane's NODE_SECRET Worker secret: signs control
# plane requests and the media tokens in /m/{token}/… URLs. Generate with:
#   openssl rand -base64 32
# NODE_SECRET=
# NODE_HOST=127.0.0.1
# NODE_PORT=9191
# Unix socket where `npm run owner-code` asks the node for a pairing code; never
# reachable through the tunnel. Default: .yolo-node.sock in the repository.
# NODE_LOCAL_SOCKET=/absolute/path/to/yolo-node.sock
# Control plane address that `npm run owner-code` prints as the sign-in URL
# PUBLIC_ORIGIN=https://yolo.example.com
# LOG_LEVEL=info

# Media pipeline (the node serves /m/*). Caches go to .segment-cache/,
# .hls-cache/ and .media-cache/ under YOLO_RUNTIME_DIR (default: the repository).
# YOLO_RUNTIME_DIR=/absolute/path/for/caches
# SEGMENT_CACHE_MAX_BYTES=21474836480
# Video bitrate ceiling for web video formats and HLS variants (500-20000)
# STREAM_MAX_VIDEO_BITRATE_KBPS=4800
# Transcode separate audio/video files with ffmpeg instead of serving them as
# fMP4 HLS over byte ranges
# DASH_TRANSCODE=0

# LAN direct play (Agent Note 2026-10-12-lan-direct-play). Once the control
# plane has the LAN_DNS_TOKEN secret, it names this node, points a DNS-only
# record at its private address, and installs a certificate; the node then
# serves /m/* to devices at home over HTTPS on that address. The key and the
# certificate live in .lan/ under YOLO_RUNTIME_DIR.
# Port of the LAN listener; 0 turns LAN direct play off on this node
# LAN_PORT=9443
# Pin the private IPv4 address to listen on (default: the first private
# address of a wired or Wi-Fi interface)
# LAN_ADDRESS=192.168.1.20
# Video bitrate ceiling on the LAN path (default 200000, effectively none)
# LAN_MAX_VIDEO_KBPS=200000
#
# The control plane's side is configured on the Worker, not here:
#   LAN_DNS_TOKEN       secret (npx wrangler secret put LAN_DNS_TOKEN): a
#                       Cloudflare API token with Zone Read and DNS Edit on the
#                       zone that holds PUBLIC_ORIGIN's host
#   LAN_ACME_DIRECTORY  var in wrangler.jsonc: the ACME directory (Let's
#                       Encrypt production there; staging when unset)

# Plex source plugin (optional; its options in yolo.config.json win)
PLEX_URL=http://localhost:32400
# PLEX_TOKEN=your-plex-token
# Fixed 720p profile; optional override is limited to 4000-4800 Kbps.
# PLEX_VIDEO_BITRATE_KBPS=4800

# yt-dlp source plugin authentication (optional; default is anonymous, no
# browser required). Set one when the source needs login or browser cookies.
# A file takes precedence.
# YTDLP_COOKIES_FROM_BROWSER=chrome
# YTDLP_COOKIES_FILE=/absolute/path/to/cookies.txt

# Yolo plugins (see Agent Note 2026-10-11-plugin-architecture).
# Without a config, the node loads the
# official source plugins listed in plugins/official.json, which read PLEX_*
# and YTDLP_* above. To choose plugins, their order and options, copy
# yolo.config.example.json to yolo.config.json (ignored by git), then restart
# the node and redeploy the control plane. YOLO_CONFIG points elsewhere,
# relative to the repository. The control plane's build reads the same file.
# YOLO_CONFIG=/absolute/path/to/yolo.config.json

# Tesla client development (npm run dev): where Vite sends Yolo's routes
# YOLO_CONTROL_URL=http://127.0.0.1:8787
