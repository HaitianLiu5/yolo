{
  "name": "yolo",
  "version": "0.17.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Yolo: a private, agent-driven media service, with one player for the Tesla browser and every other browser",
  "author": "HaitianLiu5 (https://github.com/HaitianLiu5)",
  "repository": {
    "type": "git",
    "url": "https://github.com/HaitianLiu5/yolo.git"
  },
  "homepage": "https://github.com/HaitianLiu5/yolo",
  "bugs": "https://github.com/HaitianLiu5/yolo/issues",
  "keywords": [
    "tesla",
    "media-player",
    "canvas",
    "webcodecs",
    "mediabunny",
    "hls",
    "mcp",
    "cloudflare-workers",
    "plex",
    "yt-dlp"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check": "npm run doc-sync && npm run build && node scripts/run-gates.js rules",
    "build": "npm run build -w clients/player && npm run build -w service/control",
    "doc-sync": "node scripts/run-gates.js doc-sync",
    "verify-agent-note-classification": "node scripts/verify-agent-note-classification.js",
    "verify-agent-note-format": "node scripts/verify-agent-note-format.js",
    "verify-archived-agent-notes": "node scripts/verify-archived-agent-notes.js",
    "verify-translation-pairing": "node scripts/verify-translation-pairing.js",
    "verify-md-links": "node scripts/verify-md-links.js",
    "verify-md-wrap": "node scripts/verify-md-wrap.js",
    "dev": "npm run dev -w clients/player",
    "dev:control": "npm run dev -w service/control",
    "dev:node": "npm run start -w service/node",
    "owner-code": "node service/node/scripts/owner-code.js",
    "postinstall": "node ops/yolo.js tools install --postinstall",
    "yolo": "node ops/yolo.js",
    "wrangler": "node ops/wrangler.js",
    "site:deploy": "node ops/wrangler.js deploy --config ../../site/wrangler.jsonc",
    "stack": "node scripts/stack/cli.js",
    "stack:walk": "node scripts/stack/walk.js"
  },
  "workspaces": [
    "clients/player",
    "service/core",
    "service/plugin-api",
    "service/control",
    "service/node",
    "plugins/source-plex",
    "plugins/source-ytdlp",
    "plugins/source-example",
    "plugins/source-folder",
    "plugins/source-tencent-sports",
    "plugins/dns-desec",
    "plugins/proxy-url",
    "plugins/proxy-transocks",
    "plugins/agent-claude-code",
    "plugins/agent-codex",
    "plugins/model-subscriptions",
    "plugins/metadata-local",
    "plugins/metadata-wikimedia",
    "plugins/metadata-tvmaze",
    "plugins/metadata-bangumi",
    "plugins/metadata-tmdb",
    "plugins/subtitles-openai"
  ],
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@useyolo/core": "*",
    "lefthook": "^2.2.1",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "playwright": "^1.64.0",
    "uqr": "0.1.3"
  }
}
