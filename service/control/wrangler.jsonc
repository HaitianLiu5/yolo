// The template every instance shares: it carries no owner's values. An
// instance's route or workers.dev host, PUBLIC_ORIGIN, D1 and KV ids, and
// Workers VPC service come from its yolo.instance.json; `npm run yolo --
// config render` merges the two into wrangler.instance.jsonc, which deploys
// use (`npm run wrangler -- …` picks it). This file alone serves `npm run
// build`, `npm run dev:control`, and the local D1
// (Agent Note 2026-10-13-agent-deployment).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "yolo-control",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // nodejs_compat: AsyncLocalStorage in the Agents SDK MCP handler.
  // global_fetch_strictly_public: SSRF protection for OAuth Client ID
  // Metadata Document fetches (required by workers-oauth-provider).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Served on one origin only, PUBLIC_ORIGIN: the custom domain, which the
  // rendered config adds as `routes`, or for an instance without a domain the
  // workers.dev host, where the rendered config turns `workers_dev` on
  // (Agent Note 2026-10-13-no-domain-deployment). Passkeys are bound to
  // PUBLIC_ORIGIN, so a second origin would only offer a sign-in page that
  // cannot work; preview URLs stay off for the same reason.
  "workers_dev": false,
  "preview_urls": false,
  // Workers Logs keep the Worker's own structured lines (`hub`,
  // `device_event`, `lan`, `edge`, `security`, `frame`) but no invocation logs: those record every
  // request's URL, which carries the media token in /m/{token}/…, the
  // realtime ticket, and the pairing code (Agent Note 2026-10-11-device-telemetry).
  // Query strings are also dropped from any URL that still reaches a log or a
  // trace. The rendered config keeps this as it is.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false }
  },
  // The node's media names (Agent Note 2026-10-12-lan-direct-play,
  // Agent Note 2026-10-13-media-off-the-worker): every 5 minutes the Worker
  // keeps the LAN name and, while the owner has remote access on, the remote
  // name current: their DNS-only address records and certificates, and the
  // remote path's check from outside. It does nothing until the
  // MEDIA_DNS_TOKEN secret is set.
  "triggers": { "crons": ["*/5 * * * *"] },
  // The player (clients/player) at the site root, same origin as /m/* and
  // /v1/realtime (Agent Note 2026-10-07-same-origin-media-passthrough). Its
  // _headers file adds COOP/COEP, which the SharedArrayBuffer audio path needs.
  // The routes below reach this Worker first; any other path is a static file,
  // or index.html for the client's own routes (/play, /show/…). Build the
  // client before deploying (`npm run build` at the repository root does both).
  "assets": {
    "directory": "../../clients/player/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/v1/*", "/m/*", "/mcp", "/mcp/*", "/oauth/*", "/.well-known/*",
      "/login", "/device", "/account", "/auth/*", "/healthz", "/health"
    ]
  },
  // Plugins' control entries are bundled at build time
  // (Agent Note 2026-10-11-plugin-architecture): this writes
  // src/plugins.generated.js from the plugin config, and
  // src/build-info.generated.js with the version /.well-known/yolo reports,
  // before every `wrangler dev` and `wrangler deploy`.
  "build": { "command": "node scripts/generate-plugins.js && node scripts/generate-build-info.js" },
  "vars": {
    // Public origin of this Worker (https://<host> when rendered: the custom
    // domain or the workers.dev host; empty means the request's own origin, as
    // in local development). It is the OAuth issuer, the token audience, and
    // the passkey relying party; changing it invalidates every passkey.
    "PUBLIC_ORIGIN": "",
    // "vpc" uses the NODE binding the rendered config adds; "tunnel" uses
    // NODE_PUBLIC_ORIGIN with a Cloudflare Access service token
    // (Agent Note 2026-10-08-workers-vpc-node-access).
    "NODE_TRANSPORT": "vpc",
    // Address of the node as seen from the machine running cloudflared
    // (rendered from the instance's node.port).
    "NODE_ORIGIN": "http://127.0.0.1:9191",
    "NODE_PUBLIC_ORIGIN": "",
    // Where the certificates of the node's media names come from, and of
    // the home's address without a domain, which the node obtains itself.
    // Without this var the staging directory is used, whose certificates
    // browsers reject.
    "LAN_ACME_DIRECTORY": "https://acme-v02.api.letsencrypt.org/directory",
    // How remote direct play is certified (rendered from the instance's
    // media.wan.certificate): "name", a name in the domain's zone, or "ip",
    // the home's public address, without a domain
    // (Agent Note 2026-10-13-no-domain-deployment).
    "WAN_CERTIFICATE": "name"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yolo",
      // A placeholder for local use; the rendered config has the instance's
      // id (`npm run yolo -- provision d1`).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      // OAuth clients, grants and token hashes, plus owner sessions and passkey
      // challenges. Realtime tickets live in the Hub (src/realtime.js).
      "binding": "OAUTH_KV",
      // A placeholder for local use; the rendered config has the instance's
      // id (`npm run yolo -- provision kv`).
      "id": "00000000000000000000000000000000"
    }
  ],
  // Per-address limits on what anyone can reach without a credential
  // (src/rate-limit.js): sign-in, pairing and OAuth requests, and /m/* tokens
  // the node refused; and FRAME_LIMIT, video frames per agent
  // (Agent Note 2026-10-13-video-frames). The rendered config keeps them as
  // they are. A namespace_id is an integer unique in the account; two
  // instances in one account would only share these counters, whose keys
  // differ. The counters are per Cloudflare location.
  "ratelimits": [
    { "name": "PUBLIC_LIMIT", "namespace_id": "4201", "simple": { "limit": 60, "period": 60 } },
    { "name": "MEDIA_DENIED_LIMIT", "namespace_id": "4202", "simple": { "limit": 30, "period": 60 } },
    { "name": "FRAME_LIMIT", "namespace_id": "4203", "simple": { "limit": 20, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }]
  // The rendered config adds the Workers VPC binding NODE, a VPC service for
  // 127.0.0.1:<node.port> on the instance's tunnel (`npm run yolo -- provision
  // vpc`). Without it the Worker reaches no node, as in local development,
  // where .dev.vars selects NODE_TRANSPORT "tunnel" (see .dev.vars.example).
  //
  // Secrets (`npm run wrangler -- secret put …`):
  //   NODE_SECRET               shared with the node; signs requests and media
  //                             tokens. `npm run yolo -- deploy` uploads it from .env
  //   NODE_ACCESS_CLIENT_ID     only when NODE_TRANSPORT is "tunnel"
  //   NODE_ACCESS_CLIENT_SECRET only when NODE_TRANSPORT is "tunnel"
  //   MEDIA_DNS_TOKEN           optional, only with a domain; turns on LAN and
  //                             remote direct play by name. A Cloudflare API token
  //                             with Zone Read and DNS Edit on the zone that holds
  //                             PUBLIC_ORIGIN's host; `npm run yolo -- provision
  //                             media-dns` creates and stores it.
  //                             LAN_DNS_TOKEN, its name before 0.5, is read until
  //                             the release after it
  // The owner's first passkey (or a reset) needs no secret here: the home node
  // issues a 6-digit pairing code with `npm run owner-code`
  // (Agent Note 2026-10-08-passkey-owner-sign-in).
}
