// Build settings for Yolo's Apple clients
// (Agent Note 2026-10-19-apple-tv-client). The owner's team id and bundle id
// prefix live in the ignored clients/apple/Local.xcconfig (copy
// Local.xcconfig.example), never in a tracked file; without it the app
// builds and runs in the Simulator unsigned.

// Yolo's one version; `npm run yolo -- release prepare` sets it.
MARKETING_VERSION = 0.9.3
CURRENT_PROJECT_VERSION = 1

SDKROOT = appletvos
SUPPORTED_PLATFORMS = appletvos appletvsimulator
TARGETED_DEVICE_FAMILY = 3
TVOS_DEPLOYMENT_TARGET = 18.0
SWIFT_VERSION = 6.0

BUNDLE_ID_PREFIX = dev.yolo.local
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic
#include? "../Local.xcconfig"

PRODUCT_NAME = Yolo
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID_PREFIX).tv
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = Config/TV-Info.plist
INFOPLIST_KEY_CFBundleDisplayName = Yolo
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIUserInterfaceStyle = Dark
INFOPLIST_KEY_NSLocalNetworkUsageDescription = Yolo finds your Yolo server and plays its videos over your home network.
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
ALWAYS_SEARCH_USER_PATHS = NO
ENABLE_USER_SCRIPT_SANDBOXING = YES
ENABLE_PREVIEWS = YES
