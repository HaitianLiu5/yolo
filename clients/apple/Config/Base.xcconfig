// Build settings both of Yolo's Apple clients share
// (Agent Notes 2026-10-19-apple-tv-client and 2026-10-23-iphone-and-ipad-client);
// TV.xcconfig and iOS.xcconfig add each platform's. The owner's team id and
// bundle id prefix live in the ignored clients/apple/Local.xcconfig (copy
// Local.xcconfig.example), never in a tracked file; without it the apps
// build and run in the Simulator unsigned.

// Yolo's one version; `npm run yolo -- release prepare` sets it.
MARKETING_VERSION = 0.12.0
// Each upload's build number; clients/apple/archive.sh sets it from the time.
CURRENT_PROJECT_VERSION = 1

SWIFT_VERSION = 6.0

BUNDLE_ID_PREFIX = dev.yolo.local
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic
#include? "../Local.xcconfig"

PRODUCT_NAME = Yolo
// One bundle id on both platforms, so one App Store Connect record and one
// TestFlight group carry them (universal purchase).
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID_PREFIX).yolo
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Yolo
INFOPLIST_KEY_UILaunchScreen_Generation = YES
// Only HTTPS: no export compliance questions at each upload.
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO
INFOPLIST_KEY_NSLocalNetworkUsageDescription = Yolo finds your Yolo server and plays its videos over your home network.
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
ALWAYS_SEARCH_USER_PATHS = NO
ENABLE_USER_SCRIPT_SANDBOXING = YES
ENABLE_PREVIEWS = YES
